APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Providers: openai, anthropic, openrouter, deepseek, ollama, groq
INFERENCE_PROVIDER=openrouter
INFERENCE_MODEL=
INFERENCE_API_KEY=

# Required by FullAdminSeeder only when the account does not exist.
FULL_ADMIN_PASSWORD=

# Voice providers are independent: browser, compatible, or disabled.
AUDIO_STT_PROVIDER=browser
AUDIO_TTS_PROVIDER=browser
# Compatible endpoints may be external or local. Credentials stay on the backend.
AUDIO_STT_URL=https://api.openai.com/v1/audio/transcriptions
AUDIO_STT_KEY=
AUDIO_STT_MODEL=whisper-1
AUDIO_TTS_URL=https://api.openai.com/v1/audio/speech
AUDIO_TTS_KEY=
AUDIO_TTS_MODEL=tts-1
AUDIO_TTS_VOICE=alloy
# Describe the actual configured destination, especially when using a local service.
AUDIO_STT_DISCLOSURE="El audio se envía al servicio STT configurado en el servidor."
AUDIO_TTS_DISCLOSURE="El texto de la versión oral se envía al servicio TTS configurado en el servidor."
AUDIO_FFPROBE=ffprobe
